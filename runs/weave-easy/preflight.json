        "source": "// Controller only: external tape supplies read_bit; move_right=0 means left.\n// clk advances one TM step; synchronous reset starts state A; halt freezes state.\nmodule tm(input clk, input reset, input read_bit,\n          output reg write_bit, output reg move_right, output reg halt);\n  reg [0:0] state;\n  reg [0:0] next_state;\n  always @* begin\n    write_bit = read_bit; move_right = 1'b0; halt = 1'b1;\n    next_state = state;\n    case ({state, read_bit})\n      2'd0: begin write_bit = 1'b1; move_right = 1'b0; halt = 1'b0; next_state = 1'd1; end\n      2'd1: begin write_bit = 1'b0; move_right = 1'b0; halt = 1'b0; next_state = 1'd1; end\n      2'd2: begin write_bit = 1'b1; move_right = 1'b1; halt = 1'b0; next_state = 1'd0; end\n      2'd3: begin write_bit = 1'b1; move_right = 1'b0; halt = 1'b0; next_state = 1'd0; end\n      default: begin end\n    endcase\n  end\n  always @(posedge clk) begin\n    if (reset) state <= 1'd0;\n    else if (!halt) state <= next_state;\n  end\nendmodule\n",
